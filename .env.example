ENVIRONMENT=development
NODE_ENV=development
POSTGRES_DB=optimalride
POSTGRES_USER=optimalride
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+asyncpg://optimalride:replace-with-a-random-local-password@postgres:5432/optimalride
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
OTP_HMAC_KEY=replace-with-a-separate-random-secret
LICENCE_HMAC_KEY=replace-with-a-third-random-secret
FERNET_KEY=replace-with-a-generated-fernet-key
REDIS_URL=redis://redis:6379/0
AUTO_CREATE_SCHEMA=false
DEV_OTP_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_ENABLED=false
LICENCE_CLASS_MAP_REVIEWED=false
VERIFICATION_REGION=Karnataka
LICENCE_CLASS_MAP={"bike":["MCWG"],"auto":["3W-T","LMV-3W","e-rickshaw"],"cab":["LMV-TR","LMV"]}
VEHICLE_CAPACITIES={"bike":1,"auto":3,"cab":4}
BOOKING_SEARCH_TIMEOUT_SECONDS=900
SEAT_HOLD_TTL_SECONDS=60
OTP_EXPIRE_MINUTES=5
TRIP_OTP_EXPIRE_MINUTES=5