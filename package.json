{
  "name": "safevoyage-sentinel",
  "version": "1.0.0",
  "description": "SafeVoyage Sentinel – Express Gateway + Vite React SPA for SIH2026",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --loader ts-node/esm server.ts",
    "server:dev": "nodemon --exec 'node --loader ts-node/esm server.ts' --ext ts",
    "compile": "tsc --noEmit",
    "start": "node dist/server.js",
    "build:all": "npm run build && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "uuid": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "lucide-react": "^0.447.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/uuid": "^10.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
