# =============================================================================
# SafeVoyage Sentinel – Dockerfile for Python FastAPI Microservice
# Installs backend deps and runs Uvicorn on port 8000.
# =============================================================================
FROM python:3.11-slim AS runtime

WORKDIR /app/backend

# Install system deps for OpenCV, MediaPipe and ONNX Runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 \
  && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY backend/requirements.text ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the FastAPI application
COPY backend/ .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
